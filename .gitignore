# Apps that have been removed — block them from being silently
# re-created by stale local scripts or runaway makemigrations runs.
apps/claim_verifier/
apps/competitors/
apps/compliance/
apps/messaging/
apps/social_leads/
apps/voice_agent/

# The frontend moved to the ftb-ui repo (consumed via GHCR image).
# What's left locally is a dead build husk — never track it again.
frontend/

# Google service account keys - never commit
fb-project-*.json
*-serviceaccount.json
service-account*.json
*env*
*env
# Secrets — never commit keys or credentials
*.key
*service*account*.json
fb-project-*.json
gcp-*.json

# Ruff writes its own self-ignore file into .ruff_cache/, but don't rely on it.
.ruff_cache/

# Stray Windows absolute paths created by tools run in POSIX mode: pip-audit
# passed a "C:\Users\...\Temp\.cache" path was treated as a *relative* dir and
# built the whole tree inside the repo. Narrow pattern so a legitimate
# capitalised top-level dir is never silently ignored.
/C*/Users/

# Terraform — state, per-environment config, provider binaries.
# State can contain resource metadata; backend.hcl and tfvars are
# per-environment. The lock file IS committed on purpose.
infra/.terraform/
infra/.terraform.lock.hcl.bak
infra/*.tfstate
infra/*.tfstate.*
infra/backend.hcl
infra/terraform.tfvars
infra/*.tfplan
crash.log

# Local RAG vector indexes (RAG_VECTOR_BACKEND=chroma), the benchmark
# twin and the eval scratch. Derived data, rebuildable from Postgres -
# never commit.
.chroma*/
