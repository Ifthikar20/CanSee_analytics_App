# ═══════════════════════════════════════════════════════
#  Cansee — Production Environment Variables
#  Copy to .env.prod and fill in real values. Never commit .env.prod.
#  Leave an API key blank to switch its feature off.
# ═══════════════════════════════════════════════════════

# ── Django ──
DJANGO_SECRET_KEY=CHANGE_ME_USE_50_CHAR_RANDOM_STRING
DJANGO_SETTINGS_MODULE=config.settings.prod
DEBUG=False
# localhost is required by the container and deploy health checks.
ALLOWED_HOSTS=cansee.ai,www.cansee.ai,localhost
# "https" behind TLS (nginx.prod.conf); "http" only for a bare-IP deploy with nginx.http.conf.
PUBLIC_SCHEME=https
# Public origin of this API (the WorkOS SSO callback is built from it).
BACKEND_PUBLIC_URL=https://cansee.ai
# Origin of the web app; used in emails and OAuth return links.
FRONTEND_URL=https://cansee.ai
# Extra trusted origins for CSRF; blank = derived from ALLOWED_HOSTS.
CSRF_TRUSTED_ORIGINS=
# Django admin path; must match the admin location in docker/nginx/nginx.prod.conf.
# ADMIN_URL=
# Public self-serve sign-up; while False, operators create accounts with manage.py create_user.
SIGNUPS_ENABLED=False
# Organizations, invitations and business sign-in (SSO).
ORG_FEATURES_ENABLED=False

# ── Database (internal Docker network) ──
DB_NAME=cansee
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_HOST=db
DB_PORT=5432
# libpq sslmode; use require or verify-full once Postgres is off this host.
DB_SSLMODE=prefer
# CA bundle path for DB_SSLMODE=verify-full.
DB_SSLROOTCERT=
# Private dotted DB hostnames allowed without TLS (comma-separated).
DB_TRUSTED_HOSTS=

# ── Redis (internal Docker network) ──
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# ── JWT ──
JWT_SIGNING_KEY=CHANGE_ME_USE_64_CHAR_RANDOM_STRING

# ── Field Encryption ──
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=CHANGE_ME

# ── CORS ──
CORS_ALLOWED_ORIGINS=https://cansee.ai,https://www.cansee.ai

# ── AI engines (each blank key removes that engine) ──
# Claude: answers, extraction, onboarding scan, prompt suggestions, assistant,
# and the agent workspace (no agent run starts without it).
ANTHROPIC_API_KEY=
# ChatGPT answers and all embeddings.
OPENAI_API_KEY=
GEMINI_API_KEY=
PERPLEXITY_API_KEY=
XAI_API_KEY=
# Model overrides; blank uses the built-in defaults.
LLM_CLAUDE_MODEL=
LLM_EXTRACTION_MODEL=
# Web-search tools on Claude/GPT/Gemini/Grok (Perplexity is always web-grounded); costs more per call.
LLM_WEBSEARCH_ENABLED=false

# ── Prompt synthesis (tooling only, never audit answers) ──
DEEPSEEK_API_KEY=
# deepseek or anthropic; leave commented to use deepseek when DEEPSEEK_API_KEY is set, else anthropic.
# PROMPT_SYNTHESIS_PROVIDER=

# ── Agent workspace (apps.agent) ──
# Off until true. Also needs COMPOSE_PROFILES=agent in docker/.env (the agent
# service) and ANTHROPIC_API_KEY; SERPAPI_KEY powers its Google research.
# See the README's Agent service section.
AGENT_ENABLED=false
# Optional overrides; leave commented for the defaults in config/settings/base.py
# (a blank value is not a default here and fails for the numeric ones).
# AGENT_MODEL=claude-opus-5-5
# AGENT_RUN_MAX_COST_USD=3.0
# AGENT_CHAT_RETENTION_DAYS=0
# How many agents run at once. Replies the agent process runs at the same
# time (a reply sent while all are busy waits in line), and replies one user
# may run at once across chats:
# AGENT_MAX_CONCURRENT_RUNS=6
# AGENT_USER_ACTIVE_RUNS=2
# Research agents: the most agents one research may plan (also stated to the
# model), how many run at once in one research and across the process:
# AGENT_SWARM_MAX_TASKS=50
# AGENT_SWARM_WORKERS=8
# AGENT_SWARM_PROCESS_WORKERS=16
# Per-provider limits shared by every research. Keep them within the SerpAPI
# or ScraperAPI plan's concurrency and each engine's rate limits (higher values
# cause 429s, shown as failed agents). ENGINE is per AI engine.
# AGENT_SWARM_SERP_CONCURRENCY=5
# AGENT_SWARM_BROWSE_CONCURRENCY=6
# AGENT_SWARM_ENGINE_CONCURRENCY=3
# AGENT_SWARM_HAIKU_CONCURRENCY=8

# ── Google rank and search ──
# Google results: SerpAPI, or ScraperAPI's structured Google search. With both
# set SerpAPI is used unless SERP_PROVIDER pins one. The "Who's asking" panel
# and prompt mining need SerpAPI itself. Both power the rank per prompt (search
# gap), Brand Research, the agent workspace's Google research and the
# onboarding scan's competitors and buyer questions.
SERPAPI_KEY=
SCRAPERAPI_KEY=
# SERP_PROVIDER=scraperapi
# SCRAPERAPI_COST_PER_SEARCH_USD=0
# Onboarding scan: seconds per Google search, and searches per user per day.
# ONBOARDING_SERP_TIMEOUT=20
# ONBOARDING_SERP_DAILY_SEARCHES=15
# Google Programmable Search: competitor discovery and run enrichment.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
# Yelp Fusion: Yelp pages in source scans.
YELP_API_KEY=

# ── Billing (Polar) ──
# Paywall switch. MANAGED BY THE DEPLOY PIPELINE from the PAYWALL_ENABLED
# repository variable; hand-edits here are overwritten on the next deploy.
PAYWALL_ENABLED=False
POLAR_ACCESS_TOKEN=
# sandbox or production; use production for live billing.
POLAR_ENVIRONMENT=sandbox
# Product ids from manage.py polar_billing_bootstrap.
POLAR_PRODUCT_PRO_MONTHLY_ID=
POLAR_PRODUCT_PRO_ANNUAL_ID=
# Webhook signing secret from the Polar dashboard.
POLAR_WEBHOOK_SECRET=
# Meter ids from manage.py polar_bootstrap.
POLAR_METER_TOKENS_ID=
POLAR_METER_SPEND_ID=
# celery, inline or off; leave commented for celery when POLAR_ACCESS_TOKEN is set, else off.
# POLAR_INGEST_MODE=
# Read usage from Polar meters only after manage.py polar_parity_check passes.
POLAR_READS_ENABLED=False
# Free plan: prompt runs a month (one prompt answered by one AI engine), and the
# hidden AI spend backstop for its Claude-only work, never shown in dollars.
# Leave commented for the defaults (20 runs, $3).
# FREE_MONTHLY_PROMPT_RUNS=20
# AI_FREE_MONTHLY_CAP_USD=3.0
# Minutes before a prompt run a worker never settled is given back.
# PROMPT_RUN_STALE_MINUTES=30

# ── Sign-in ──
# Google sign-in; also used for Search Console and GA4.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Microsoft (Entra) sign-in.
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# SAML bridge for business SSO: ssoready or workos.
SSO_BRIDGE_PROVIDER=ssoready
SSOREADY_API_KEY=
WORKOS_API_KEY=
WORKOS_CLIENT_ID=

# ── Google Search Console ──
# Reuses GOOGLE_OAUTH_CLIENT_ID/SECRET; add this URI to the Google OAuth client.
GSC_OAUTH_REDIRECT_URI=https://cansee.ai/api/v1/search-console/oauth/callback/
GSC_DAILY_ROW_LIMIT=5000
GSC_BACKFILL_DAYS=28
GSC_SYNC_LOOKBACK_DAYS=7
GSC_RETENTION_DAYS=480
GSC_DAILY_API_LIMIT_PER_USER=2000
GSC_PROMPT_MIN_IMPRESSIONS=10
GSC_PROMPT_TOP_N=50

# ── Web Analytics external sources ──
WEB_ANALYTICS_ENABLED=true
# Reuses GOOGLE_OAUTH_CLIENT_ID/SECRET; add this URI to the Google OAuth client.
GA4_OAUTH_REDIRECT_URI=https://cansee.ai/api/v1/web-analytics/ga4/oauth/callback/
GA4_SNAPSHOT_TTL_SECONDS=25
GA4_FETCH_TIMEOUT_SECONDS=6
GA4_DAILY_API_LIMIT_PER_WEBSITE=15000
# Hosted Google tag: service-account key JSON on one line, plus the pool property id.
GA4_SA_CREDENTIALS_JSON=
GA4_HOSTED_PROPERTY_ID=
CLOUDFLARE_SNAPSHOT_TTL_SECONDS=120
CLOUDFLARE_FETCH_TIMEOUT_SECONDS=10
# MaxMind GeoLite2-Country.mmdb path; blank sends visitor IPs to ip-api.com for the country.
GEOIP_PATH=

# ── Chat bots ──
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=
DISCORD_BOT_TOKEN=

# ── SMS (Twilio) ──
SMS_ENABLED=False
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# The exact webhook URL configured in Twilio (signature validation).
TWILIO_WEBHOOK_URL=

# ── Email (SMTP) ──
# Blank EMAIL_HOST fails `manage.py check --deploy`; sends fail instead of going nowhere.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL="Cansee <noreply@cansee.ai>"
SERVER_EMAIL=noreply@cansee.ai
# Receives Django error mail.
OPS_EMAIL=ops@cansee.ai

# ── AWS S3 (static files) ──
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
# Customer-managed KMS key; blank uses SSE-S3 (AES256).
AWS_S3_KMS_KEY_ID=

# ── Error tracking ──
SENTRY_DSN=

# ── Internal admin ops API (ftb-min admin server) ──
# Shared key; blank disables the surface.
ADMIN_OPS_KEY=
# Source CIDRs allowed to call it, e.g. 10.0.1.7/32; blank denies everyone.
ADMIN_OPS_ALLOWED_CIDRS=

# -- Internal services (Docker-network only; never exposed via nginx) --
# Empty URLs = Django runs the logic in-process (dev/test default).
# Generate tokens with: openssl rand -hex 32
INTELLIGENCE_SERVICE_URL=http://intelligence.ftb.internal:8000
INTELLIGENCE_AUTH_TOKEN=CHANGE_ME_RANDOM_TOKEN
SOURCES_SERVICE_URL=http://sources.ftb.internal:8000
SOURCES_AUTH_TOKEN=CHANGE_ME_RANDOM_TOKEN
